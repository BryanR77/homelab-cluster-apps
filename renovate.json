{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "argocd",
    "custom.regex"
  ],
  "argocd": {
    "managerFilePatterns": [
      "/^apps/.+\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/paperclip-image\\.yml$/"
      ],
      "matchStrings": [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*UPSTREAM_REF:\\s*(?<currentValue>\\S+)"
      ]
    }
  ]
}
